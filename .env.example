# Required: use a dedicated test database for the remote APK trial.
# Replace placeholders; URL-encode special characters in the database password.
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/quanlychitieu_test"

# Required: fill with a private random signing key before starting.
# Do not replace an existing key during a normal restart.
JWT_SECRET=

# Optional Google login. Email/password testing does not require these.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CALLBACK_URL=
API_URL=http://localhost:3000
WEB_ADMIN_URL=http://localhost:3001

# Optional email: password reset and email reports require a working SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM defaults to SMTP_USER when omitted.
# SMTP_FROM=your_verified_sender@example.com
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# Gemini chatbot (keep the real key only in .env)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# VNPay Sandbox. Register merchant credentials at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=your_sandbox_tmn_code
VNPAY_HASH_SECRET=your_sandbox_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/payments/vnpay/return
VNPAY_MOBILE_DEEP_LINK=quanlychitieu://payment-result
VNPAY_PREMIUM_PRICE_VND=49000

# Backend listening address (use 127.0.0.1 for local-only access)
HOST=0.0.0.0
PORT=3000
